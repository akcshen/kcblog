// ?????
.navbar
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  border-bottom 1px solid var(--borderColor)
  box-shadow 0 1px 0 rgba(0, 0, 0, 0.02)
  transition background .25s ease, box-shadow .25s ease, border-color .25s ease

  .logo
    border-radius 50%
    object-fit cover
    box-shadow 0 0 0 2px rgba($accentColor, 0.18)

  .site-name
    font-weight 700
    letter-spacing .02em
    transition color .2s ease
    &:hover
      color $accentColor

  .links
    .search-box
      input
        border-radius 999px
        border-color rgba(0, 0, 0, 0.12)
        background rgba(150, 150, 150, 0.08)
        transition border-color .2s ease, box-shadow .2s ease, background .2s ease
        &:focus
          border-color $accentColor
          box-shadow 0 0 0 3px rgba($accentColor, 0.15)
          background var(--mainBg)

.nav-links
  .nav-item > a
    margin 0 .15rem
    padding 0 .55rem
    border-radius 6px
    font-weight 500
    transition color .2s ease, background .2s ease
    &:hover
      color $accentColor
      background rgba($accentColor, 0.08)
    &.router-link-active
      color $accentColor

  .dropdown-wrapper
    .dropdown-title
      border-radius 6px
      transition color .2s ease, background .2s ease
      &:hover
        color $accentColor
        background rgba($accentColor, 0.08)
    .nav-dropdown
      border-radius 10px
      border 1px solid var(--borderColor)
      box-shadow 0 10px 28px rgba(0, 0, 0, 0.1)
      overflow hidden
      .dropdown-item
        a
          transition background .15s ease, color .15s ease
          &:hover
            color $accentColor
            background rgba($accentColor, 0.08)
          &.router-link-active
            color $accentColor
            font-weight 600

.theme-mode-dark .navbar
  box-shadow 0 1px 0 rgba(255, 255, 255, 0.04)
  .logo
    box-shadow 0 0 0 2px rgba($accentColor, 0.28)
  .links .search-box input
    border-color rgba(255, 255, 255, 0.12)
    background rgba(255, 255, 255, 0.06)
    &:focus
      background var(--mainBg)

.theme-mode-dark .nav-links .dropdown-wrapper .nav-dropdown
  box-shadow 0 12px 32px rgba(0, 0, 0, 0.45)

// ???????
.gt-container
  .gt-ico-tip
    &::after
      content: '?( Win + . ) or ( ? + ? + ? ) open Emoji'
      color: #999
  .gt-meta
    border-color var(--borderColor)!important
  .gt-comments-null
    color var(--textColor)
    opacity .5
  .gt-header-textarea
    color var(--textColor)
    background rgba(180,180,180,0.1)!important
  .gt-btn
    border-color $accentColor!important
    background-color $accentColor!important
  .gt-btn-preview
    background-color rgba(255,255,255,0)!important
    color $accentColor!important
  a
    color $accentColor!important
  .gt-svg svg
    fill $accentColor!important
  .gt-comment-content,.gt-comment-admin .gt-comment-content
    background-color rgba(150,150,150,0.1)!important
    &:hover
      box-shadow 0 0 25px rgba(150,150,150,.5)!important
    .gt-comment-body
      color var(--textColor)!important


// ????/about?? ????? / ??
$about-warm = #b57a3a
$about-cream = #f8f3ea
$about-ink = #3d342c
$about-muted = #7a6a58
$about-line = rgba(140, 100, 55, 0.18)
$about-hobby-ride = #a86b32
$about-hobby-sport = #9a5538
$about-hobby-outdoor = #7d6b3e
$about-hobby-gear = #8a7260
$about-cert-cf = #c6923a
$about-cert-cs = #a0673c

.about-page
  max-width 760px
  margin 0 auto 2.5rem
  padding 0 .5rem 1rem
  color $about-ink

.about-hero
  position relative
  overflow hidden
  text-align left
  padding 2.4rem 2rem 2.1rem
  border-radius 18px
  border 1px solid $about-line
  background:
    radial-gradient(ellipse 75% 65% at 100% 0%, rgba(201, 150, 80, 0.22), transparent 55%),
    radial-gradient(ellipse 55% 45% at 0% 100%, rgba(180, 130, 70, 0.12), transparent 50%),
    linear-gradient(165deg, $about-cream 0%, #f3ebe0 100%)
  box-shadow 0 10px 36px rgba(90, 60, 30, 0.08)

.about-kicker
  margin 0 0 .85rem
  font-size .75rem
  font-weight 600
  letter-spacing .14em
  text-transform uppercase
  color $about-warm

.about-name
  margin 0
  font-size clamp(2.1rem, 5vw, 2.85rem)
  font-weight 800
  letter-spacing -.02em
  line-height 1.15
  color $about-ink

.about-name-alias
  font-weight 500
  opacity .5
  letter-spacing 0
  font-size .55em
  margin-left .35rem

.about-role
  margin .65rem 0 0
  display inline-block
  font-size .88rem
  font-weight 600
  color $about-warm
  letter-spacing .04em

.about-lead
  margin 1.15rem 0 0
  max-width 36em
  font-size 1.05rem
  line-height 1.85
  color $about-ink
  opacity .9

.about-motto
  margin 1.6rem 0 0
  padding 1.05rem 1.25rem
  border-radius 12px
  border-left 3px solid $about-warm
  background rgba(255, 252, 246, 0.72)

.about-motto-label
  display block
  font-size .72rem
  font-weight 700
  letter-spacing .1em
  color $about-warm
  margin-bottom .4rem

.about-motto-text
  margin 0
  font-size 1.08rem
  line-height 1.7
  font-weight 500
  color $about-ink

.about-section
  margin-top 2.25rem

.about-section-title
  margin 0 0 .5rem
  font-size 1.25rem
  font-weight 700
  letter-spacing -.01em
  color $about-ink
  line-height 1.3
  &::after
    content ''
    display block
    width 2rem
    height 3px
    margin-top .55rem
    border-radius 2px
    background $about-warm

.about-section-desc
  margin 0 0 1rem
  font-size .92rem
  line-height 1.6
  color $about-muted

.about-hobby-grid
  display grid
  grid-template-columns repeat(4, 1fr)
  gap .85rem
  @media (max-width 640px)
    grid-template-columns repeat(2, 1fr)

.about-hobby-card
  display flex
  flex-direction column
  gap .4rem
  padding 1.15rem 1.05rem
  border-radius 14px
  border 1px solid $about-line
  background $about-cream
  transition transform .25s ease, box-shadow .25s ease, border-color .25s ease
  &:hover
    transform translateY(-4px)
    box-shadow 0 12px 28px rgba(90, 60, 30, 0.1)

.about-hobby-cat
  font-size .78rem
  font-weight 700
  letter-spacing .04em

.about-hobby-detail
  font-size .95rem
  line-height 1.4
  font-weight 500
  color $about-ink

.about-hobby-card--ride
  border-top 3px solid $about-hobby-ride
  background linear-gradient(180deg, rgba(168, 107, 50, 0.12) 0%, $about-cream 55%)
  .about-hobby-cat
    color $about-hobby-ride !important
  &:hover
    border-color rgba(168, 107, 50, 0.35)
    box-shadow 0 12px 28px rgba(168, 107, 50, 0.16)

.about-hobby-card--sport
  border-top 3px solid $about-hobby-sport
  background linear-gradient(180deg, rgba(154, 85, 56, 0.12) 0%, $about-cream 55%)
  .about-hobby-cat
    color $about-hobby-sport !important
  &:hover
    border-color rgba(154, 85, 56, 0.35)
    box-shadow 0 12px 28px rgba(154, 85, 56, 0.16)

.about-hobby-card--outdoor
  border-top 3px solid $about-hobby-outdoor
  background linear-gradient(180deg, rgba(125, 107, 62, 0.12) 0%, $about-cream 55%)
  .about-hobby-cat
    color $about-hobby-outdoor !important
  &:hover
    border-color rgba(125, 107, 62, 0.35)
    box-shadow 0 12px 28px rgba(125, 107, 62, 0.16)

.about-hobby-card--gear
  border-top 3px solid $about-hobby-gear
  background linear-gradient(180deg, rgba(138, 114, 96, 0.14) 0%, $about-cream 55%)
  .about-hobby-cat
    color $about-hobby-gear !important
  &:hover
    border-color rgba(138, 114, 96, 0.4)
    box-shadow 0 12px 28px rgba(138, 114, 96, 0.14)

.about-cert-list
  display flex
  flex-direction column
  gap .85rem

.about-cert
  display flex
  align-items center
  gap 1rem
  padding 1.05rem 1.2rem
  border-radius 14px
  border 1px solid $about-line
  background $about-cream
  transition transform .25s ease, box-shadow .25s ease, border-color .25s ease
  &:hover
    transform translateY(-3px)

.about-cert-badge
  flex-shrink 0
  width 3rem
  height 3rem
  display flex
  align-items center
  justify-content center
  border-radius 12px
  font-size .85rem
  font-weight 800
  letter-spacing .04em
  color #fff

.about-cert-body
  flex 1
  min-width 0
  display flex
  flex-direction column
  gap .2rem

.about-cert-game
  font-size .75rem
  font-weight 600
  letter-spacing .04em
  color $about-muted

.about-cert-title
  font-size 1.08rem
  font-weight 700
  color $about-ink
  line-height 1.35

.about-cert-tag
  flex-shrink 0
  font-size .72rem
  font-weight 700
  letter-spacing .06em
  padding .35rem .65rem
  border-radius 8px

.about-cert--cf
  background linear-gradient(105deg, rgba($about-cert-cf, 0.16) 0%, $about-cream 48%)
  .about-cert-badge
    background linear-gradient(145deg, #dbb15a, $about-cert-cf)
  .about-cert-tag
    color darken($about-cert-cf, 10%)
    background rgba($about-cert-cf, 0.18)
  &:hover
    border-color rgba($about-cert-cf, 0.45)
    box-shadow 0 12px 28px rgba($about-cert-cf, 0.22)

.about-cert--cs
  background linear-gradient(105deg, rgba($about-cert-cs, 0.14) 0%, $about-cream 48%)
  .about-cert-badge
    background linear-gradient(145deg, #c48955, $about-cert-cs)
  .about-cert-tag
    color darken($about-cert-cs, 8%)
    background rgba($about-cert-cs, 0.16)
  &:hover
    border-color rgba($about-cert-cs, 0.4)
    box-shadow 0 12px 28px rgba($about-cert-cs, 0.2)

.about-contact-list
  list-style none
  padding 0
  margin 0
  display flex
  flex-direction column
  gap .7rem

.about-contact-list li
  display flex
  flex-wrap wrap
  align-items center
  gap .5rem 1rem
  padding 1rem 1.15rem
  border-radius 14px
  border 1px solid $about-line
  background linear-gradient(180deg, rgba(255, 250, 242, 0.9) 0%, $about-cream 100%)
  transition border-color .2s ease, transform .2s ease, box-shadow .2s ease
  &:hover
    border-color rgba($about-warm, 0.4)
    transform translateY(-2px)
    box-shadow 0 8px 22px rgba(90, 60, 30, 0.08)

.about-contact-label
  min-width 5.5rem
  font-size .82rem
  font-weight 700
  letter-spacing .03em
  color $about-muted

.about-contact-link
  color $about-warm !important
  text-decoration none
  font-weight 600
  word-break break-all
  &:hover
    text-decoration underline

.theme-mode-dark .about-page
  color var(--textColor)

.theme-mode-dark .about-hero
  border-color rgba(201, 150, 80, 0.2)
  background:
    radial-gradient(ellipse 75% 65% at 100% 0%, rgba(201, 150, 80, 0.14), transparent 55%),
    radial-gradient(ellipse 55% 45% at 0% 100%, rgba(160, 110, 60, 0.08), transparent 50%),
    linear-gradient(165deg, #2a2622 0%, #322c26 100%)
  box-shadow 0 10px 36px rgba(0, 0, 0, 0.4)

.theme-mode-dark .about-name,
.theme-mode-dark .about-motto-text,
.theme-mode-dark .about-section-title,
.theme-mode-dark .about-hobby-detail,
.theme-mode-dark .about-cert-title
  color var(--textLightenColor)

.theme-mode-dark .about-lead,
.theme-mode-dark .about-section-desc,
.theme-mode-dark .about-cert-game,
.theme-mode-dark .about-contact-label
  color var(--textColor)

.theme-mode-dark .about-kicker,
.theme-mode-dark .about-role,
.theme-mode-dark .about-motto-label,
.theme-mode-dark .about-contact-link
  color lighten($about-warm, 18%) !important

.theme-mode-dark .about-motto
  background rgba(255, 220, 160, 0.06)
  border-left-color lighten($about-warm, 10%)

.theme-mode-dark .about-section-title::after
  background lighten($about-warm, 10%)

.theme-mode-dark .about-hobby-card,
.theme-mode-dark .about-cert,
.theme-mode-dark .about-contact-list li
  background #2d2925
  border-color rgba(201, 150, 80, 0.16)

.theme-mode-dark .about-hobby-card--ride,
.theme-mode-dark .about-hobby-card--sport,
.theme-mode-dark .about-hobby-card--outdoor,
.theme-mode-dark .about-hobby-card--gear,
.theme-mode-dark .about-cert--cf,
.theme-mode-dark .about-cert--cs,
.theme-mode-dark .about-contact-list li
  background linear-gradient(180deg, rgba(201, 150, 80, 0.08) 0%, #2d2925 55%)

.theme-mode-dark .about-hobby-card:hover,
.theme-mode-dark .about-cert:hover,
.theme-mode-dark .about-contact-list li:hover
  box-shadow 0 12px 30px rgba(0, 0, 0, 0.35)

.theme-mode-dark .about-cert--cf .about-cert-tag
  color lighten($about-cert-cf, 18%)
.theme-mode-dark .about-cert--cs .about-cert-tag
  color lighten($about-cert-cs, 18%)

@media (max-width 480px)
  .about-hero
    padding 1.75rem 1.25rem 1.6rem
  .about-cert
    flex-wrap wrap
  .about-cert-tag
    margin-left auto

